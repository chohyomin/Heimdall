# Heimdall environment variables
# Copy this file to `.env` and fill in values. Never commit `.env` to Git.

# ---------------------------------------------------------------------------
# Hugging Face (optional, recommended for CodeBERT downloads)
# ---------------------------------------------------------------------------
# Used by transformers/huggingface_hub when downloading `microsoft/codebert-base`.
# Without it you may hit lower rate limits (anonymous downloads still work).
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Future integrations (placeholders — not required for core Heimdall today)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DATABASE_URL=postgresql://user:password@localhost:5432/heimdall
# DJANGO_SECRET_KEY=change-me-in-production

# ---------------------------------------------------------------------------
# Internal endpoints (if you add a web UI or remote analyzer later)
# ---------------------------------------------------------------------------
# HEIMDALL_API_BASE_URL=http://127.0.0.1:8000
# REDIS_URL=redis://127.0.0.1:6379/0
